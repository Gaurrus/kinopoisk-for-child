{
  "name": "kinopoisk-for-child",
  "version": "1.2.0",
  "private": true,
  "description": "Kinopoisk HD for kids: persistent login and a per-launch episode limit",
  "main": "dist/main/main.js",
  "author": "Gaurrus",
  "license": "MIT",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "yarn clean && tsc -p tsconfig.json && esbuild src/browser/guard.ts --bundle --format=iife --target=chrome120 --outfile=dist/browser/guard.js && node scripts/copy-assets.mjs",
    "start": "yarn build && electron .",
    "dev": "yarn build && electron . --dev",
    "run": "electron .",
    "run:dev": "electron . --dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "yarn build && node --test tests/*.test.mjs",
    "dist:win": "yarn build && electron-builder --win --x64",
    "postinstall": "node node_modules/electron/install.js",
    "evs:sign": "node scripts/evs-sign.mjs",
    "evs:sign:dev": "node scripts/evs-sign.mjs --target dev",
    "evs:sign:packaged": "node scripts/evs-sign.mjs --target packaged",
    "dist:mac": "yarn build && electron-builder --mac --dir",
    "serve:updates": "node scripts/update-server.mjs",
    "pack:mac:zip": "node scripts/pack-mac-zip.mjs"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.1",
    "@types/node": "^22.10.2",
    "electron": "https://github.com/castlabs/electron-releases#v44.10.1+wvcus",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "ru.gaurrus.kinopoisk-child",
    "productName": "Kinopoisk for child",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "kinopoisk-for-child-${version}-setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "scripts/evs-after-pack.js",
    "mac": {
      "identity": null,
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "electron-updater": "^6.8.11"
  }
}
